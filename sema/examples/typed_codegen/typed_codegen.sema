sema TypedCodegen for "typed_codegen.ag";

semantic_model {
    rust_context CalcContext;
    analyzer program(seed: Int, offset: Int) -> Int;
    analyzer value(seed: Int, offset: Int) -> Int;
    intrinsic parse_decimal(text: Text) -> Result<Int>;
}

node program
    : operand=value EOF #Value analysis {
        analyze operand with offset: offset, seed: seed -> computed;
        result = computed;
      }
    ;

node value
    : text=NUMBER #Literal analysis {
        let parsed = parse_decimal(text.text);
        let sum = parsed + seed;
        result = sum + offset;
      }
    ;
