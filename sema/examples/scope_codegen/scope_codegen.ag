grammar ScopeCodegen;

options {
    parser = LALR;
    lookahead = 2;
    ast = explicit;
}

channels {
    HIDDEN
}

node program
    : name=ID EOF                         #Lookup
    | INT declared=ID SEMI target=ID ASSIGN value=NUMBER SEMI used=ID EOF #DeclareAssignRead
    | INT declared=ID SEMI EOF #DeclareOnly
    | statement_node=statement used=ID EOF #StatementAndRead
    ;

node statement
    : IF LPAREN condition=ID RPAREN then_target=ID ASSIGN then_value=NUMBER SEMI ELSE else_target=ID ASSIGN else_value=NUMBER SEMI #IfElseAssign
    | IF LPAREN condition=ID RPAREN then_target=ID ASSIGN then_value=NUMBER SEMI ELSE SEMI #IfElseEmpty
    | IF LPAREN condition=ID RPAREN then_branch=block ELSE else_branch=block #IfElseBlocks
    | target=ID ASSIGN value=NUMBER SEMI #Assign
    | used=ID SEMI #Read
    | INT declared=ID SEMI #Declare
    | nested=block #NestedBlock
    ;

node block
    : LBRACE items=statement* RBRACE #Statements
    ;

IF
    : 'if'
    ;

ELSE
    : 'else'
    ;

LPAREN
    : '('
    ;

RPAREN
    : ')'
    ;

LBRACE
    : '{'
    ;

RBRACE
    : '}'
    ;

INT
    : 'int'
    ;

SEMI
    : ';'
    ;

ASSIGN
    : '='
    ;

NUMBER
    : [0-9]+
    ;

ID
    : [a-zA-Z_] [a-zA-Z_0-9]*
    ;

WS
    : [ \t\r\n]+ -> channel(HIDDEN)
    ;
