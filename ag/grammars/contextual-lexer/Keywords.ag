grammar Keywords;
options { parser = LALR; lookahead = 2; }
lexerClasses { WORDS = false; }
node start : AT keyword | HASH identifier;
inline keyword -> enable(WORDS) : word END;
inline word : READ | WRITE;
inline identifier : IDENT END;
AT : '@';
HASH : '#';
READ : 'read' -> require(WORDS);
WRITE : 'write' -> require(WORDS);
IDENT : [a-z]+;
END : ';';
WS : [ \t\r\n]+ -> skip;
