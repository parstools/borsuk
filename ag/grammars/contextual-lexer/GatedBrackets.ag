grammar GatedBrackets;
options { parser = LALR; lookahead = 2; }
lexerClasses { SHIFT = false; BRACKETS = false; }
node start : A shifted | C separated;
inline shifted -> enable(SHIFT) : SHR B;
inline separated -> enable(BRACKETS) : GT GT D;
A : 'a';
C : 'c';
SHR : '>>' -> require(SHIFT);
GT : '>' -> require(BRACKETS);
B : 'b';
D : 'd';
WS : [ \t\r\n]+ -> skip;
