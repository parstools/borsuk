class Counter {
private:
    int value;

public:
    Counter(int initial) {
        value = initial;
    }

    ~Counter() {
        value = 0;
    }

    void increment() {
        value += 1;
    }

    int get() {
        return value;
    }
};

class Deferred {
public:
    Deferred();
    ~Deferred();
    int get();

private:
    int value;
};

Deferred::Deferred() {
    value = 1;
}

Deferred::~Deferred() {
    value = 0;
}

int Deferred::get() {
    return value;
}

int main() {
    Counter outer(5);
    {
        Counter inner(2);
        inner.increment();
    }
    Deferred later;
    outer.increment();
    return outer.get() + later.get();
}
