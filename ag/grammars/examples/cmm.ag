/*
 * Extremely small C-like grammar in the restricted Agas notation.
 * It is intended as a compact input for testing grammar generators.
 */

grammar Cmm;

options {
    parser = LR;
    lookahead = 1;
    ast = explicit;
}

channels {
    HIDDEN
}

node program
    : declarations=declaration+ EOF
    ;

inline declaration
    : value=varDeclaration
    | value=varInitialization
    | value=statement
    ;

node declarator
    : name=ID
    ;

node varDeclaration
    : type=typeSpecifier name=declarator SEMI
    ;

inline typeSpecifier
    : value=INT
    ;

node compoundStatement
    : LBRACE declarations=declaration* RBRACE
    ;

node varInitialization
    : type=typeSpecifier name=declarator ASSIGN value=additiveExpression SEMI
    ;

inline relop
    : value=LE
    | value=LT
    | value=GT
    | value=GE
    | value=EQ
    | value=NEQ
    ;

node booleanExpression
    : left=additiveExpression operator=relop right=additiveExpression
    ;

inline addop
    : value=PLUS
    | value=MINUS
    ;

node additiveExpression
    : first=factor rest=additiveOperation*
    ;

inline additiveOperation
    : operator=addop operand=factor
    ;

node factor
    : value=varUsage       #VariableFactor
    | value=call           #CallFactor
    | value=NUMBER         #NumberFactor
    | MINUS operand=factor #NegatedFactor
    ;

node varUsage
    : name=ID
    ;

node call
    : name=ID LPAREN arguments=argList? RPAREN
    ;

node argList
    : first=argument rest=argumentTail*
    ;

inline argumentTail
    : COMMA value=argument
    ;

inline argument
    : value=additiveExpression
    ;

inline statement
    : value=whileStatement
    | value=assignStatement SEMI
    | value=call SEMI
    | value=compoundStatement
    ;

node whileStatement
    : WHILE LPAREN condition=booleanExpression RPAREN body=statement
    ;

node assignStatement
    : target=varUsage ASSIGN value=additiveExpression
    ;

PLUS   : '+';
MINUS  : '-';
COMMA  : ',';
LPAREN : '(';
RPAREN : ')';
LBRACE : '{';
RBRACE : '}';
SEMI   : ';';
LT     : '<';
LE     : '<=';
GT     : '>';
GE     : '>=';
ASSIGN : '=';
EQ     : '==';
NEQ    : '!=';
INT    : 'int';
WHILE  : 'while';

LINE_COMMENT
    : '//' ~[\r\n]* -> channel(HIDDEN)
    ;

ID
    : [a-zA-Z_] [a-zA-Z_0-9]*
    ;

NUMBER
    : '0'
    | [1-9] [0-9]*
    ;

WS
    : [ \t\r\n]+ -> channel(HIDDEN)
    ;
